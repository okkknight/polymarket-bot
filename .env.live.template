# Polymarket live execution environment template
# Copy to a secure place and export before live run.

# Required
PRIVATE_KEY=
POLY_CLOB_API_KEY=
POLY_CLOB_API_SECRET=
POLY_CLOB_API_PASSPHRASE=
POLY_SIGNATURE_TYPE=2
POLY_FUNDER=

# Optional (defaults shown)
POLY_CLOB_BASE_URL=https://clob.polymarket.com
POLY_CLOB_ORDER_PATH=/order
POLY_CLOB_ORDER_STATUS_PATH=/order/{orderId}

# Live risk guardrail defaults (can override)
MAX_ORDER_NOTIONAL=20
MAX_ORDERS_PER_MINUTE=6
DAILY_LOSS_LIMIT=20
COOLDOWN_SEC=30

# Optional automatic claim (both switches default to false; enabling requires
# a separate human approval for the first real redeem).
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
# Create this under Polymarket Settings → API Keys → Relayer API Keys. The
# address must match the local PRIVATE_KEY signer, not the Safe/funder wallet.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
AUTO_CLAIM_ENABLED=false
CLAIM_EXECUTION_APPROVED=false
